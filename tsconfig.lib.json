{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "skipLibCheck": true,
    "strict": false
  },
  "include": [
    "src/vite-env.d.ts",
    "src/index.ts",
    "src/components/ui/**/*",
    "src/tokens/**/*"
  ]
}
